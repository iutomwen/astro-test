---
// src/components/ImageTextContainer.astro
export interface ImageTextProps {
  title: string;
  description: string;
  buttonText?: string;
  buttonLink?: string;
  phoneNumber?: string;
  phoneDescription?: string;
  secondaryButtonText?: string;
  secondaryButtonLink?: string;
  image?: string;
  imageAlt?: string;
  backgroundColor?: string;
  textColor?: string;
}

interface Props extends ImageTextProps {}

const {
  title,
  description,
  buttonText = "Find the right help for you",
  buttonLink = "#",
  phoneNumber = "0800 029 4378",
  phoneDescription = "Speak to an expert 24/7",
  secondaryButtonText = "Arrange a callback",
  secondaryButtonLink = "#",
  image = "https://picsum.photos/500/400?random=1",
  imageAlt = "Support representative",
  backgroundColor = "bg-gray-100",
  textColor = "text-gray-900",
} = Astro.props;
---

<section class={`py-16 ${backgroundColor}`}>
  <div class="container mx-auto px-6">
    <div
      class="flex flex-col lg:flex-row lg:items-center lg:space-x-12 max-w-6xl mx-auto"
    >
      <!-- Left Side - Image -->
      <div class="lg:w-5/12 mb-8 lg:mb-0">
        <div class="relative rounded-lg overflow-hidden shadow-lg">
          <img
            src={image}
            alt={imageAlt}
            class="w-full h-80 md:h-96 lg:h-[400px] object-cover"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Right Side - Content -->
      <div class="lg:w-7/12">
        <div class="space-y-8">
          <!-- Main Content -->
          <div class="space-y-6">
            <h2
              class={`text-3xl md:text-4xl lg:text-5xl font-bold leading-tight ${textColor}`}
            >
              {title}
            </h2>

            <p class="text-lg text-gray-700 leading-relaxed max-w-2xl">
              {description}
            </p>

            <!-- Primary Button -->
            {
              buttonText && buttonLink && (
                <div class="pt-4">
                  <a
                    href={buttonLink}
                    class="inline-flex items-center justify-center px-8 py-4 bg-white border-2 border-blue-600 text-blue-600 hover:bg-blue-600 hover:text-white font-semibold rounded-full transition-all duration-200 shadow-sm hover:shadow-md"
                  >
                    {buttonText}
                  </a>
                </div>
              )
            }
          </div>

          <!-- Contact Section -->
          <div class="border-t border-gray-300 pt-8">
            <div
              class="flex flex-col md:flex-row md:items-center md:justify-between gap-6"
            >
              <!-- Phone Contact -->
              {
                phoneNumber && (
                  <div class="flex flex-col">
                    <div class="flex items-center space-x-2 mb-2">
                      <span class="text-2xl md:text-3xl font-bold text-red-500">
                        {phoneNumber}
                      </span>
                      <span class="text-gray-600 font-medium">OR</span>
                    </div>
                    {phoneDescription && (
                      <div class="flex items-center space-x-2">
                        <div class="w-2 h-2 bg-blue-600 rounded-full" />
                        <span class="text-gray-600 text-sm">
                          {phoneDescription}
                        </span>
                      </div>
                    )}
                  </div>
                )
              }

              <!-- Secondary Button -->
              {
                secondaryButtonText && secondaryButtonLink && (
                  <div>
                    <a
                      href={secondaryButtonLink}
                      class="inline-flex items-center justify-center px-8 py-3 bg-white border-2 border-blue-600 text-blue-600 hover:bg-blue-600 hover:text-white font-semibold rounded-full transition-all duration-200 shadow-sm hover:shadow-md"
                    >
                      {secondaryButtonText}
                    </a>
                  </div>
                )
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
