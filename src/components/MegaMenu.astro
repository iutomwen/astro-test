---
// src/components/MegaMenu.astro
const { primaryNav } = Astro.props;
---

<style>
  /* Prevent Alpine.js FOUC */
  [x-cloak] {
    display: none !important;
  }
</style>

<div class="relative w-full" x-data="{ open: null }" x-cloak>
  <ul class="flex gap-6 text-black">
    {
      primaryNav.map((item: any, index: number) => (
        <li class="relative xl:mx-5 lg:mx-2">
          <a
            href={item.link}
            class="hover:text-gray-900 block py-2 font-bold"
            @mouseenter={`open = ${index}`}
            @mouseleave="open = null"
          >
            {item.label}
          </a>

          {item.submenu && item.submenu.length > 0 && (
            <div
              x-show={`open === ${index}`}
              x-transition:enter="transition ease-out duration-200"
              x-transition:enter-start="opacity-0 transform scale-95"
              x-transition:enter-end="opacity-100 transform scale-100"
              x-transition:leave="transition ease-in duration-150"
              x-transition:leave-start="opacity-100 transform scale-100"
              x-transition:leave-end="opacity-0 transform scale-95"
              @mouseenter={`open = ${index}`}
              @mouseleave="open = null"
              class="absolute top-full bg-white bg-opacity-95 backdrop-blur shadow-lg border-t border-gray-100 z-50 rounded-md"
              style="left: 50%; transform: translateX(-50%); width: calc(60vw);"
            >
              <div
                class="absolute -top-1 w-4 h-4 bg-white border-l border-t border-gray-100 transform rotate-45"
                style="left: 50%; transform: translateX(-50%);"
              />
              <div class=" px-8 py-8">
                <div class="grid grid-cols-3 gap-8 max-w-6xl">
                  {item.submenu.map((sub: any) => (
                    <a
                      href={sub.link}
                      class="block p-6 rounded-xl transition-colors hover:border-gray-200 hover:bg-cyan-50"
                    >
                      <div class="font-semibold text-gray-900 text-xl mb-3">
                        {sub.label}
                      </div>
                      {sub.description && (
                        <p class="text-sm text-gray-600 leading-relaxed">
                          {sub.description}
                        </p>
                      )}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          )}
        </li>
      ))
    }
  </ul>
</div>
