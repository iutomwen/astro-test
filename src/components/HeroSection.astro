---
import { Image } from 'astro:assets';

// src/components/HeroSection.astro
export interface HeroSectionProps {
  title: string;
  highlightText?: string;
  subtitle?: string;
  primaryButtonText?: string;
  primaryButtonLink?: string;
  secondaryButtonText?: string;
  secondaryButtonLink?: string;
  backgroundImage?: string;
  showGoogleRating?: boolean;
  googleRating?: number;
  googleReviewCount?: string;
  showContactForm?: boolean;
}

interface Props extends HeroSectionProps {}

const {
  title,
  highlightText = "Award-winning",
  subtitle,
  primaryButtonText = "Speak to an expert",
  primaryButtonLink = "#contact",
  secondaryButtonText = "View services and pricing",
  secondaryButtonLink = "/services",
  backgroundImage = "https://picsum.photos/1920/800?random=hero",
  showGoogleRating = true,
  googleRating = 4.8,
  googleReviewCount = "1,600+",
  showContactForm = true
} = Astro.props;
---

<section class="relative min-h-screen flex items-center bg-gray-100 overflow-hidden pt-5">
  <!-- Background Image -->
  <div class="absolute inset-0 z-0">
    <Image 
      src={backgroundImage}
      alt="Hero background"
      class="w-full h-full object-cover"
      width={1920}
      height={800}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-white/60 bg-opacity-60"></div>
  </div>

  <div class="relative z-10 w-full">
    <div class="container mx-auto px-6 py-16">
      <div class="flex flex-col lg:flex-row lg:items-center lg:space-x-12 max-w-7xl mx-auto">
        
        <!-- Left Side - Content -->
        <div class="lg:w-1/2 mb-12 lg:mb-0">
          <div class="space-y-8 max-w-2xl">
            
            <!-- Main Heading -->
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight">
              <span class="text-red-500 relative">
                {highlightText}
                <svg class="absolute -bottom-2 left-0 w-full h-3" viewBox="0 0 200 10" fill="none">
                  <path d="M2 8C50 2 100 2 198 8" stroke="#ef4444" stroke-width="3" stroke-linecap="round"/>
                </svg>
              </span>
              <span class="text-gray-800 block mt-2">{title}</span>
            </h1>
            
            {subtitle && (
              <p class="text-xl text-gray-700 leading-relaxed">
                {subtitle}
              </p>
            )}
            
            <!-- Google Rating -->
            {showGoogleRating && (
              <div class="flex items-center space-x-4 py-4">
                <div class="flex items-center space-x-2">
                  <img src="https://www.google.com/favicon.ico" alt="Google" class="w-8 h-8">
                  <span class="font-semibold text-gray-800">Google Rating</span>
                </div>
                <div class="flex items-center space-x-2">
                  <span class="text-2xl font-bold text-gray-800">{googleRating}</span>
                  <div class="flex space-x-1">
                    {Array.from({ length: 5 }, (_, i) => (
                      <svg 
                        class={`w-5 h-5 ${i < Math.floor(googleRating) ? 'text-yellow-400' : 'text-gray-300'}`}
                        fill="currentColor" 
                        viewBox="0 0 20 20"
                      >
                        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                      </svg>
                    ))}
                  </div>
                </div>
                <div class="text-gray-600">
                  <span class="font-medium">Based on {googleReviewCount} Reviews</span>
                </div>
              </div>
            )}
            
            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 pt-4">
              {primaryButtonText && primaryButtonLink && (
                <a 
                  href={primaryButtonLink}
                  class="inline-flex items-center justify-center px-8 py-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-full transition-colors duration-200 shadow-lg hover:shadow-xl"
                >
                  {primaryButtonText}
                </a>
              )}
              
              {secondaryButtonText && secondaryButtonLink && (
                <a 
                  href={secondaryButtonLink}
                  class="inline-flex items-center justify-center px-8 py-4 bg-white border-2 border-blue-600 text-blue-600 hover:bg-blue-600 hover:text-white font-semibold rounded-full transition-all duration-200 shadow-lg hover:shadow-xl"
                >
                  {secondaryButtonText}
                </a>
              )}
            </div>
          </div>
        </div>
        
        <!-- Right Side - Contact Form -->
        {showContactForm && (
          <div class="lg:w-1/2">
            <div class="bg-white rounded-lg shadow-2xl overflow-hidden max-w-md ml-auto">
              <!-- Form Header -->
              <div class="bg-gray-800 text-white px-6 py-4">
                <h3 class="text-xl font-semibold">Speak to an expert now</h3>
              </div>
              
              <!-- Form Content -->
              <div class="p-6">
                <form class="space-y-4" method="POST" action="/contact">
                  <!-- Name Fields -->
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label for="firstName" class="block text-sm font-medium text-gray-700 mb-1">
                        First Name
                      </label>
                      <input
                        type="text"
                        id="firstName"
                        name="firstName"
                        required
                        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                      />
                    </div>
                    <div>
                      <label for="lastName" class="block text-sm font-medium text-gray-700 mb-1">
                        Last Name
                      </label>
                      <input
                        type="text"
                        id="lastName"
                        name="lastName"
                        required
                        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                      />
                    </div>
                  </div>
                  
                  <!-- Company and Email -->
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                      <label for="company" class="block text-sm font-medium text-gray-700 mb-1">
                        Company
                      </label>
                      <input
                        type="text"
                        id="company"
                        name="company"
                        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                      />
                    </div>
                    <div>
                      <label for="email" class="block text-sm font-medium text-gray-700 mb-1">
                        Email Address
                      </label>
                      <input
                        type="email"
                        id="email"
                        name="email"
                        required
                        class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                      />
                    </div>
                  </div>
                  
                  <!-- Phone Number -->
                  <div>
                    <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">
                      Best Number To Call You On
                    </label>
                    <input
                      type="tel"
                      id="phone"
                      name="phone"
                      required
                      class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
                    />
                  </div>
                  
                  <!-- Callback Time -->
                  <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">
                      When shall we call you?
                    </label>
                    <p class="text-xs text-gray-600 mb-3">
                      Callbacks can be as quick as within 8 minutes
                    </p>
                    <div class="flex space-x-3">
                      <label class="flex items-center">
                        <input
                          type="radio"
                          name="callbackTime"
                          value="asap"
                          class="sr-only"
                          checked
                        />
                        <span class="px-4 py-2 bg-gray-800 text-white text-sm font-medium rounded-full cursor-pointer">
                          As soon as possible
                        </span>
                      </label>
                      <label class="flex items-center">
                        <input
                          type="radio"
                          name="callbackTime"
                          value="choose"
                          class="sr-only"
                        />
                        <span class="px-4 py-2 bg-gray-200 text-gray-700 text-sm font-medium rounded-full cursor-pointer hover:bg-gray-300">
                          Choose a time
                        </span>
                      </label>
                    </div>
                  </div>
                  
                  <!-- Submit Button -->
                  <div class="pt-4">
                    <button
                      type="submit"
                      class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-6 rounded-full transition-colors duration-200"
                    >
                      Submit
                    </button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<script>
  // Handle radio button styling
  document.addEventListener('DOMContentLoaded', function() {
    const radioButtons = document.querySelectorAll('input[name="callbackTime"]') as NodeListOf<HTMLInputElement>;
    const labels = document.querySelectorAll('input[name="callbackTime"] + span');
    
    radioButtons.forEach((radio, index) => {
      radio.addEventListener('change', function() {
        labels.forEach((label, labelIndex) => {
          if (labelIndex === index && radio.checked) {
            label.className = 'px-4 py-2 bg-gray-800 text-white text-sm font-medium rounded-full cursor-pointer';
          } else {
            label.className = 'px-4 py-2 bg-gray-200 text-gray-700 text-sm font-medium rounded-full cursor-pointer hover:bg-gray-300';
          }
        });
      });
    });
  });
</script>
