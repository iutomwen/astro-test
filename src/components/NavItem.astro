---
type Props = {
  link: Array<{ label: string; link: string; submenu?: Array<{ label: string; link: string }> }>;
};

const { link } = Astro.props;
---


 <div class="space-y-3">
        {
          link.map((item, index: number) => (
            <div class="bg-white rounded-lg hover:bg-cyan-50 overflow-hidden">
              {item.submenu && item.submenu.length > 0 ? (
                <>
                  <button
                    @click={`openSubmenu[${index}] = !openSubmenu[${index}]`}
                    class="flex items-center justify-between w-full text-left p-4 text-gray-800 font-semibold hover:bg-cyan-50 transition-colors"
                  >
                    <span>{item.label}</span>
                    <svg
                      class="w-5 h-5 transition-transform duration-200 text-gray-500"
                      :class={`openSubmenu[${index}] ? 'rotate-180' : ''`}
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                  </button>
                  <div 
                    x-show={`openSubmenu[${index}]`}
                    x-transition:enter="transition ease-out duration-200"
                    x-transition:enter-start="opacity-0 max-h-0"
                    x-transition:enter-end="opacity-100 max-h-screen"
                    x-transition:leave="transition ease-in duration-150"
                    x-transition:leave-start="opacity-100 max-h-screen"
                    x-transition:leave-end="opacity-0 max-h-0"
                    class="bg-gray-50 border-t border-gray-200 overflow-hidden"
                  >
                    {item.submenu.map((sub) => (
                      <a
                        href={sub.link}
                        @click="drawerOpen = false"
                        class="block p-4 text-gray-700 hover:bg-white hover:text-blue-600 transition-colors border-b border-gray-100 last:border-b-0"
                      >
                        {sub.label}
                      </a>
                    ))}
                  </div>
                </>
              ) : (
                <a
                  href={item.link}
                  @click="drawerOpen = false"
                  class="block p-4 text-gray-800 font-semibold hover:bg-cyan-50 transition-colors"
                >
                  {item.label}
                </a>
              )}
            </div>
          ))
        }
      </div>