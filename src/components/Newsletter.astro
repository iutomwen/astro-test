---
// src/components/Newsletter.astro

interface Props {
  title?: string;
  subtitle?: string;
  placeholder?: string;
  buttonText?: string;
  backgroundColor?: string;
}

const {
  title = "Sign up to our newsletter",
  subtitle = "Get the latest news & tips that matter most to your business in our monthly newsletter.",
  placeholder = "Your email address",
  buttonText = "Subscribe",
  backgroundColor = "bg-gray-50",
} = Astro.props;
---

<section class={`py-16 ${backgroundColor}`}>
  <div class="container mx-auto px-6">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Header -->
      <div class="mb-8">
        <h2
          class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-4"
        >
          {title}
        </h2>
        <p class="text-lg text-gray-600 max-w-2xl mx-auto leading-relaxed">
          {subtitle}
        </p>
      </div>

      <!-- Newsletter Form -->
      <div class="max-w-2xl mx-auto">
        <div
          x-data="{
            email: '',
            isSubmitting: false,
            showSuccess: false,
            showError: false,
            message: '',
            
            async handleSubmit() {
              if (!this.email) return;
              
              this.isSubmitting = true;
              this.showSuccess = false;
              this.showError = false;
              
              try {
                // Simulate API call - replace with your actual newsletter service
                await new Promise(resolve => setTimeout(resolve, 1500));
                
                // Success
                this.isSubmitting = false;
                this.showSuccess = true;
                this.message = 'Thank you for subscribing! Check your email for confirmation.';
                this.email = '';
                
                // Hide success message after 5 seconds
                setTimeout(() => {
                  this.showSuccess = false;
                }, 5000);
                
              } catch (error) {
                // Error handling
                this.isSubmitting = false;
                this.showError = true;
                this.message = 'Something went wrong. Please try again.';
                
                setTimeout(() => {
                  this.showError = false;
                }, 5000);
              }
            }
          }"
        >
          <form
            @submit.prevent="handleSubmit()"
            class="flex flex-col sm:flex-row gap-4 sm:gap-0"
          >
            <!-- Email Input -->
            <div class="flex-1 relative">
              <input
                type="email"
                x-model="email"
                placeholder={placeholder}
                required
                class="w-full px-6 py-4 text-lg border-2 border-gray-300 rounded-l-full sm:rounded-r-none rounded-r-full focus:border-blue-500 focus:outline-none focus:ring-0 transition-colors duration-200 bg-white text-gray-900 placeholder-gray-500"
              />
            </div>

            <!-- Subscribe Button -->
            <button
              type="submit"
              :disabled="isSubmitting || !email"
              class="px-8 py-4 bg-blue-600 hover:bg-blue-700 disabled:bg-blue-400 text-white font-semibold text-lg rounded-r-full sm:rounded-l-none rounded-l-full transition-colors duration-200 whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2"
              :class="{ 'cursor-not-allowed': isSubmitting || !email }"
            >
              <span x-show="!isSubmitting">{buttonText}</span>
              <span x-show="isSubmitting" class="flex items-center">
                <svg
                  class="animate-spin -ml-1 mr-2 h-4 w-4 text-white"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                >
                  <circle
                    class="opacity-25"
                    cx="12"
                    cy="12"
                    r="10"
                    stroke="currentColor"
                    stroke-width="4"></circle>
                  <path
                    class="opacity-75"
                    fill="currentColor"
                    d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
                  ></path>
                </svg>
                Subscribing...
              </span>
            </button>
          </form>

          <!-- Success/Error Messages -->
          <div class="mt-4">
            <!-- Success Message -->
            <div
              x-show="showSuccess"
              x-transition:enter="transition ease-out duration-300"
              x-transition:enter-start="opacity-0 transform translate-y-2"
              x-transition:enter-end="opacity-100 transform translate-y-0"
              class="p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg"
            >
              <div class="flex items-center">
                <svg
                  class="w-5 h-5 mr-2"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                    clip-rule="evenodd"></path>
                </svg>
                <span x-text="message"></span>
              </div>
            </div>

            <!-- Error Message -->
            <div
              x-show="showError"
              x-transition:enter="transition ease-out duration-300"
              x-transition:enter-start="opacity-0 transform translate-y-2"
              x-transition:enter-end="opacity-100 transform translate-y-0"
              class="p-4 bg-red-100 border border-red-400 text-red-700 rounded-lg"
            >
              <div class="flex items-center">
                <svg
                  class="w-5 h-5 mr-2"
                  fill="currentColor"
                  viewBox="0 0 20 20"
                >
                  <path
                    fill-rule="evenodd"
                    d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z"
                    clip-rule="evenodd"></path>
                </svg>
                <span x-text="message"></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Privacy Notice -->
        <p class="text-sm text-gray-500 mt-6 max-w-lg mx-auto">
          By subscribing, you agree to our
          <a href="/privacy" class="text-blue-600 hover:text-blue-800 underline"
            >Privacy Policy</a
          >
          and consent to receive updates from our company.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  /* Custom focus styles for better accessibility */
  input:focus {
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
  }

  button:focus {
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
  }

  /* Smooth transitions */
  input,
  button {
    transition: all 0.2s ease-in-out;
  }
</style>
