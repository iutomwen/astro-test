---
// src/components/ParallaxSlider.astro
export interface Slide {
  id: number;
  title: string;
  subtitle?: string;
  description: string;
  features?: string[];
  buttonText?: string;
  buttonLink?: string;
  secondaryButtonText?: string;
  secondaryButtonLink?: string;
  image: string;
  imageAlt?: string;
  textColor?: string;
}

interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;
---

<style>
  .slide-hidden {
    opacity: 0;
    transform: translateY(20px);
    pointer-events: none;
  }
  
  .slide-enter-up {
    opacity: 1;
    transform: translateY(0);
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    animation: slideEnterUp 0.6s ease-out;
  }
  
  .slide-enter-down {
    opacity: 1;
    transform: translateY(0);
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    animation: slideEnterDown 0.6s ease-out;
  }
  
  .slide-exit-up {
    opacity: 0;
    transform: translateY(-20px);
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }
  
  .slide-exit-down {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }
  
  @keyframes slideEnterUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes slideEnterDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>

<div 
  class="relative w-full bg-gray-50"
  x-data={`{
    currentSlide: 0,
    previousSlide: 0,
    slides: ${JSON.stringify(slides)},
    isTransitioning: false,
    
    goToSlide(index) {
      if (this.isTransitioning || index === this.currentSlide) return;
      
      this.isTransitioning = true;
      this.previousSlide = this.currentSlide;
      this.currentSlide = index;
      
      setTimeout(() => {
        this.isTransitioning = false;
      }, 600);
    },
    
    getSlideDirection(slideIndex) {
      if (slideIndex === this.currentSlide) return 'current';
      if (slideIndex === this.previousSlide) return 'previous';
      return 'hidden';
    },
    
    getTransitionClass(slideIndex) {
      const direction = this.getSlideDirection(slideIndex);
      const isMovingUp = this.currentSlide < this.previousSlide;
      
      if (direction === 'current') {
        return isMovingUp ? 'slide-enter-up' : 'slide-enter-down';
      } else if (direction === 'previous') {
        return isMovingUp ? 'slide-exit-down' : 'slide-exit-up';
      }
      return 'slide-hidden';
    }
  }`}
  class="relative w-full bg-gray-50"
>
  <!-- Header -->
  <div class="text-center py-12">
    <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900">
      Packages to suit <span class="text-red-500">all</span> UK businesses...
    </h2>
  </div>

  <!-- Main Content Area -->
  <div class="container mx-auto px-6 pb-16">
    <div class="flex flex-col lg:flex-row lg:space-x-12">
      
      <!-- Left Side - Navigation (Desktop) -->
      <div class="hidden lg:block lg:w-1/12">
        <div class="flex flex-col items-center space-y-6 pt-8">
          {slides.map((_, index) => (
            <button
              @click={`goToSlide(${index})`}
              class="block w-2 h-20 rounded-full transition-all duration-300"
              :class={`currentSlide === ${index} ? 'bg-blue-600' : 'bg-gray-300 hover:bg-gray-400'`}
            ></button>
          ))}
        </div>
      </div>

      <!-- Center - Content -->
      <div class="lg:w-6/12 relative min-h-[600px]">
        <template x-for="(slide, index) in slides" :key="slide.id">
          <div
            x-show={`getSlideDirection(index) !== 'hidden'`}
            :class="getTransitionClass(index)"
            class="absolute inset-0 w-full pl-8"
          >
            <!-- Colored Border - Peninsula Style -->
            <!-- <div class="absolute left-0 top-0 w-1 h-full bg-blue-600"></div> -->
            
            <!-- Title -->
            <h3 
              class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 leading-tight mb-6"
              x-html="slide.title"
            ></h3>
            
            <!-- Description -->
            <p 
              class="text-lg text-gray-700 leading-relaxed mb-6"
              x-text="slide.description"
            ></p>
            
            <!-- Additional Info -->
            <div x-show="slide.subtitle" class="text-gray-800 font-medium mb-4" x-text="slide.subtitle"></div>
            
            <!-- Features List -->
            <div x-show="slide.features && slide.features.length > 0" class="mb-8">
              <template x-for="feature in slide.features" :key="feature">
                <div class="flex items-center space-x-3 mb-3">
                  <svg class="w-5 h-5 text-blue-600 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                  <span class="text-gray-700" x-text="feature"></span>
                </div>
              </template>
            </div>
            
            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-4">
              <a 
                x-show="slide.buttonText && slide.buttonLink"
                :href="slide.buttonLink"
                class="inline-flex items-center justify-center px-8 py-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-full transition-colors duration-200"
                x-text="slide.buttonText"
              ></a>
              
              <a 
                x-show="slide.secondaryButtonText && slide.secondaryButtonLink"
                :href="slide.secondaryButtonLink"
                class="inline-flex items-center text-blue-600 hover:text-blue-800 font-semibold transition-colors duration-200 underline"
                x-text="slide.secondaryButtonText"
              ></a>
            </div>
          </div>
        </template>
      </div>
      
      <!-- Right Side - Images -->
      <div class="lg:w-5/12 mt-8 lg:mt-0">
        <div class="relative h-80 md:h-96 lg:h-[400px] rounded-lg overflow-hidden">
          <template x-for="(slide, index) in slides" :key="slide.id">
            <img
              x-show={`currentSlide === index`}
              x-transition:enter="transition-all duration-600 ease-out"
              x-transition:enter-start="opacity-0 transform scale-105"
              x-transition:enter-end="opacity-100 transform scale-100"
              x-transition:leave="transition-all duration-400 ease-in"
              x-transition:leave-start="opacity-100 transform scale-100"
              x-transition:leave-end="opacity-0 transform scale-95"
              :src="slide.image"
              :alt="slide.imageAlt || slide.title"
              class="absolute inset-0 w-full h-full object-cover rounded-lg"
            />
          </template>
        </div>
      </div>
    </div>

    <!-- Mobile Navigation - Bottom -->
    <div class="lg:hidden mt-12 flex justify-center">
      <div class="flex space-x-3 bg-white rounded-full px-6 py-3 shadow-lg">
        {slides.map((_, index) => (
          <button
            @click={`goToSlide(${index})`}
            class="w-3 h-3 rounded-full transition-all duration-200"
            :class={`currentSlide === ${index} ? 'bg-blue-600' : 'bg-gray-300 hover:bg-gray-400'`}
          ></button>
        ))}
      </div>
    </div>
  </div>
</div>
