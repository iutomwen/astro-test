<!-- ░░ STYLES ░░ -->

<style>
  /* -- Tokens ------------------------------------------------------------ */
  :root {
    --ep-bg:        #0d0d0d;
    --ep-card:      #111111;
    --ep-border:    rgba(255,255,255,.08);
    --ep-accent:    #c8f04d;          /* lime pop */
    --ep-text:      #f0ede6;
    --ep-muted:     rgba(240,237,230,.5);
    --ep-radius:    18px;
    --ep-duration:  300ms;
  }

  /* -- Overlay ------------------------------------------------------------ */
  .ep-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,.72);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    padding: 1.5rem;

    /* animation state */
    opacity: 0;
    transition: opacity var(--ep-duration) ease;
  }
  .ep-overlay[hidden] { display: none !important; }
  .ep-overlay.ep-visible { opacity: 1; }

  /* -- Card --------------------------------------------------------------- */
  .ep-card {
    position: relative;
    background: var(--ep-card);
    border: 1px solid var(--ep-border);
    border-radius: var(--ep-radius);
    max-width: 460px;
    width: 100%;
    overflow: hidden;
    box-shadow:
      0 0 0 1px rgba(255,255,255,.04),
      0 32px 64px rgba(0,0,0,.7);

    /* slide-up on enter */
    transform: translateY(24px) scale(.97);
    transition:
      transform var(--ep-duration) cubic-bezier(.22,.68,0,1.2),
      opacity var(--ep-duration) ease;
    opacity: 0;
  }
  .ep-overlay.ep-visible .ep-card {
    transform: translateY(0) scale(1);
    opacity: 1;
  }

  /* -- Decorative accent bar --------------------------------------------- */
  .ep-accent {
    height: 4px;
    background: linear-gradient(90deg, var(--ep-accent) 0%, #7cf5a2 100%);
  }

  /* -- Close button ------------------------------------------------------- */
  .ep-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 32px;
    height: 32px;
    border: 1px solid var(--ep-border);
    border-radius: 50%;
    background: rgba(255,255,255,.05);
    color: var(--ep-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background .15s, color .15s;
    padding: 0;
  }
  .ep-close:hover { background: rgba(255,255,255,.12); color: var(--ep-text); }

  /* -- Body --------------------------------------------------------------- */
  .ep-body {
    padding: 2.25rem 2.25rem 2rem;
  }

  .ep-eyebrow {
    font-family: 'DM Mono', 'Fira Mono', monospace;
    font-size: .72rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--ep-accent);
    margin: 0 0 .75rem;
  }

  .ep-heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    line-height: 1.2;
    color: var(--ep-text);
    margin: 0 0 .875rem;
  }

  .ep-subtext {
    font-family: system-ui, sans-serif;
    font-size: .95rem;
    line-height: 1.65;
    color: var(--ep-muted);
    margin: 0 0 1.75rem;
  }

  /* -- Actions ------------------------------------------------------------ */
  .ep-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .ep-cta {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .75rem 1.6rem;
    background: var(--ep-accent);
    color: #0d0d0d;
    font-family: system-ui, sans-serif;
    font-size: .9rem;
    font-weight: 700;
    letter-spacing: .02em;
    border-radius: 100px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: filter .2s, transform .15s;
  }
  .ep-cta:hover  { filter: brightness(1.1); transform: translateY(-1px); }
  .ep-cta:active { transform: translateY(0); }

  .ep-dismiss {
    background: none;
    border: none;
    font-family: system-ui, sans-serif;
    font-size: .85rem;
    color: var(--ep-muted);
    cursor: pointer;
    padding: 0;
    transition: color .15s;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .ep-dismiss:hover { color: var(--ep-text); }

  /* -- Reduced motion ---------------------------------------------------- */
  @media (prefers-reduced-motion: reduce) {
    .ep-overlay, .ep-card { transition: none; }
  }
</style>

<!-- ░░ SCRIPT ░░ -->

<script define:vars={{ cookieDays }}>
  (function () {
    const COOKIE = "ep_dismissed";
    const overlay = document.getElementById("exit-overlay");

    function getCookie(name) {
      return document.cookie.split("; ").some(c => c.startsWith(name + "="));
    }
    function setCookie(name, days) {
      const exp = new Date(Date.now() + days * 864e5).toUTCString();
      document.cookie = `${name}=1; expires=${exp}; path=/; SameSite=Lax`;
    }
    function showModal() {
      if (getCookie(COOKIE)) return;
      overlay.hidden = false;
      // tiny rAF so the transition actually fires
      requestAnimationFrame(() => requestAnimationFrame(() => overlay.classList.add("ep-visible")));
    }
    function hideModal() {
      overlay.classList.remove("ep-visible");
      overlay.addEventListener("transitionend", () => { overlay.hidden = true; }, { once: true });
      setCookie(COOKIE, cookieDays);
    }

    // Exit-intent: mouse leaves toward top of viewport
    document.addEventListener("mouseleave", e => {
      if (e.clientY <= 0) showModal();
    });

    // Mobile fallback: show on 40 % scroll depth after 8 s idle
    let mobileTimer = null;
    function onScroll() {
      const depth = window.scrollY / (document.body.scrollHeight - window.innerHeight);
      if (depth > 0.4) {
        clearTimeout(mobileTimer);
        mobileTimer = setTimeout(showModal, 8000);
        window.removeEventListener("scroll", onScroll);
      }
    }
    if ("ontouchstart" in window) window.addEventListener("scroll", onScroll, { passive: true });

    // Close triggers
    document.getElementById("ep-close").addEventListener("click", hideModal);
    document.getElementById("ep-dismiss").addEventListener("click", hideModal);
    overlay.addEventListener("click", e => { if (e.target === overlay) hideModal(); });
    document.addEventListener("keydown", e => { if (e.key === "Escape") hideModal(); });
    document.getElementById("ep-cta").addEventListener("click", hideModal);
  })();
</script>