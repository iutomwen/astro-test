  }

  // ✅ DEFAULT: deny everything (GDPR safe)
  gtag('consent', 'default', {
    ad_storage: 'denied',
    analytics_storage: 'denied',
    ad_user_data: 'denied',
    ad_personalization: 'denied',
    wait_for_update: 500
  });
</script>

optwrapper

<script is:inline>
  function OptanonWrapper() {
    const consent = window.OnetrustActiveGroups || "";

    const hasAnalytics = consent.includes("C0002");
    const hasMarketing = consent.includes("C0004");

    // ✅ Update Google Consent Mode
    gtag('consent', 'update', {
      analytics_storage: hasAnalytics ? 'granted' : 'denied',
      ad_storage: hasMarketing ? 'granted' : 'denied',
      ad_user_data: hasMarketing ? 'granted' : 'denied',
      ad_personalization: hasMarketing ? 'granted' : 'denied'
    });

    // ✅ Load GTM only after consent
    if (hasAnalytics || hasMarketing) {
      window.loadGTM && window.loadGTM();
    }
  }
</script>






<script>

// formHandler.js - Add this script to your Astro layout or component

document.addEventListener('DOMContentLoaded', () => {
  const isMobile = () => window.innerWidth < 768; // adjust breakpoint as needed

  document.querySelectorAll('a[href="#form"]').forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault(); // stops hash from appearing in URL

      if (isMobile()) {
        // Open your modal
        openFormModal();
      } else {
        // Smooth scroll to hero form
        const heroForm = document.getElementById('hero-form');
        if (heroForm) {
          heroForm.scrollIntoView({ behavior: 'smooth' });
        }
      }
    });
  });
});

function openFormModal() {
  const modal = document.getElementById('form-modal'); // adjust to your modal's ID
  if (modal) {
    modal.classList.add('open'); // or however you currently toggle it
    modal.removeAttribute('hidden');
  }
}

</script>