---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Qwik Form with Astro Actions">
  <main>
    <div class="container mx-auto px-4 py-8">
      <div class="mb-8 text-center">
        <h1 class="text-3xl font-bold text-white mb-4">
          🚀 Qwik Form + Astro Actions
        </h1>
        <p class="text-gray-300 max-w-2xl mx-auto">
          This demo shows how to integrate Qwik reactive forms with Astro
          Actions for server-side processing, validation, and type safety.
        </p>
      </div>

      <div id="qwik-form-container"></div>

      <div class="mt-8 text-center">
        <div class="inline-block bg-gray-800 rounded-lg p-6 text-left">
          <h3 class="text-lg font-semibold text-white mb-3">✨ Features:</h3>
          <ul class="text-gray-300 space-y-2 text-sm">
            <li>• ⚡ Qwik reactive form with real-time validation</li>
            <li>• 🛡️ Server-side validation with Zod schema</li>
            <li>• 🔒 Type-safe form handling</li>
            <li>• 🎯 Astro Actions integration</li>
            <li>• 📝 Error handling & success feedback</li>
            <li>• 🚫 No HTML required attributes (pure JS validation)</li>
          </ul>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  import { render } from "@builder.io/qwik";
  import FormDemo from "../components/qwik/ui/FormDemo";

  // Render the Qwik component
  render(document.getElementById("qwik-form-container")!, FormDemo);
</script>

<style>
  main {
    margin: auto;
    padding: 1rem;
    width: 100%;
    max-width: 100%;
    color: white;
    font-size: 16px;
    line-height: 1.6;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
  }
</style>
